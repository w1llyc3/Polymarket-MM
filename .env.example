# Lesson 2 needs no credentials. Exchange endpoints cannot be overridden.
NBA_DB=data/nba.sqlite
NBA_STALE_SECONDS=30
NBA_RESYNC_SECONDS=60
# Lesson 3 optional authorized odds-data API key (not a wallet/private key).
# Read from process environment; .env is not automatically loaded.
ODDS_API_KEY=
# Lessons 4/5 are offline PAPER only and read no wallet credentials.
# Risk/latency settings: examples/quote-policy.json and examples/paper-policy.json.
# There is no LIVE/TRADING_ENABLED setting and no private-key field.
# Lesson 6 uses JSON model assumptions; taker fee defaults to unknown/manual review.
# examples/lesson6-models.json contains no credentials and no execution permission.
# v2: python -m nba_recorder.inplay selects explicit BOOK_DRIVEN paper mode.
# ODDS_API_KEY is NOT required for BOOK_DRIVEN; do not synthesize fair sources.
# Strategy mode is CLI/policy controlled, never an environment Live toggle.
